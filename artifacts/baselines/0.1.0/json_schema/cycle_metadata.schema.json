{
  "$defs": {
    "CyclePhase": {
      "description": "Cycle execution phase.",
      "enum": [
        "collecting",
        "analyzing",
        "publishing",
        "completed",
        "failed"
      ],
      "title": "CyclePhase",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Minimal cycle control metadata shared by orchestrator consumers.",
  "properties": {
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "phase": {
      "$ref": "#/$defs/CyclePhase"
    },
    "previous_cycle_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Cycle Id"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "version": {
      "default": "0.1.0",
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "cycle_id",
    "phase",
    "started_at"
  ],
  "title": "CycleMetadata",
  "type": "object",
  "x-contract-version": "0.1.0",
  "x-source-model": "contracts.schemas.cycle.CycleMetadata"
}
